# QQCode API Configuration
# Copy this file to .env and fill in your own credentials.
# NEVER commit a filled-in .env — it is gitignored for that reason.

# Anthropic API (claude-haiku-4-5, claude-sonnet-5, claude-opus-5)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: custom base URL for an Anthropic-compatible gateway
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI API (gpt-5-mini, gpt-5)
OPENAI_API_KEY=sk-your-key-here
# Optional: custom base URL for an OpenAI-compatible gateway.
# The /v1 suffix is required — without it the SDK builds a URL that returns
# HTML instead of JSON, which surfaces much later as a confusing type error.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default provider: "anthropic" or "openai"
DEFAULT_PROVIDER=anthropic

# Optional: enable debug logging
# DEBUG=false
